{
  "name": "predator-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Predator - aplikacja na komputer",
  "main": "main.js",
  "author": "Predator",
  "scripts": {
    "start": "electron .",
    "copy-client": "node copy-client.js",
    "dist:win": "node copy-client.js && electron-builder --win",
    "dist:mac": "node copy-client.js && electron-builder --mac",
    "dist:linux": "node copy-client.js && electron-builder --linux"
  },
  "build": {
    "appId": "com.predator.game",
    "productName": "Predator",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "app/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "fileAssociations": [
      {
        "ext": "pgame",
        "name": "Gra Predator",
        "description": "Gra Predator",
        "role": "Editor",
        "icon": "icon.png"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
