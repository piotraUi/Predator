{
  "name": "predator-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Predator - aplikacja na komputer",
  "main": "main.js",
  "author": "Predator",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.predator.game",
    "productName": "Predator",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "connect.html", "icon.png"],
    "win": { "target": ["nsis", "portable"], "icon": "icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": "dmg", "icon": "icon.png" },
    "linux": { "target": "AppImage", "icon": "icon.png" }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
