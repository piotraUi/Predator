{
  "name": "@predator/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test ../shared/*.test.ts ../shared/**/*.test.ts ../client/src/studio/ai.test.ts ../client/src/studio/toolbox.test.ts ../client/src/studio/aiProviders.test.ts ../client/src/apex/*.test.ts ../ai-model/gen/*.test.ts src/*.test.ts",
