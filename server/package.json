    "ai:eval": "tsx ../ai-model/gen/eval.ts"
  },
  "dependencies": {
    "@colyseus/ws-transport": "^0.16.5",
    "colyseus": "^0.16.5",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "fengari": "^0.1.5",
    "fflate": "^0.8.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
