{
 "format": "predator-game",
 "version": 1,
 "name": "Ludzik 3 & Nero",
 "description": "Platformówka 2D w stylu pixel-art: 10 poziomów z trampolinami, beczkami i lodem, lot przez kosmos i dwie walki z Gigantem. Graj jako Ludzik, Nero albo Pies!",
 "maxPlayers": 30,
 "data": {
  "parts": [],
  "scripts": [
   {
    "id": "mutheg9es38udn",
    "name": "Menu",
    "type": "lua",
    "source": "-- Menu z oryginału: Start = poziom 1, wybór poziomu 1-10, potem wybór postaci (Ludzik, Nero, Pies)\nlocal wybrany = {}\nonGuiClick(function(player, gui, button)\n  if gui == \"Menu\" and button == \"Start\" then\n    wybrany[player] = 1\n    setLevel(player, \"Wybór postaci\")\n  elseif gui == \"Wybor poziomow\" then\n    local n = tonumber(string.match(button, \"^_(%d+)$\"))\n    if n then\n      wybrany[player] = n\n      setLevel(player, \"Wybór postaci\")\n    end\n  elseif gui == \"Wybór postaci\" and (button == \"Ludzik\" or button == \"Nero\" or button == \"Pies\") then\n    chooseCharacter(player, button)\n    setLevel(player, \"Level \" .. (wybrany[player] or 1))\n  end\nend)\n",
    "enabled": true
   },
   {
    "id": "mutheg9fs4jmut",
    "name": "Poziomy",
    "type": "lua",
    "source": "-- Kolejne poziomy (w GDevelopie: tabliczka \"koniec\", drzwi i teleporty)\nlocal NEXT = {\n  [\"Level 1\"] = \"Level 2\",\n  [\"Level 2\"] = \"Level 3\",\n  [\"Level 3\"] = \"Level 4\",\n  [\"Level 4\"] = \"Level 5\",\n  [\"Level 5\"] = \"Ending\",\n  [\"Level 6\"] = \"Level 7\",\n  [\"Level 7\"] = \"Level 8\",\n  [\"Level 8\"] = \"Level 9\",\n  [\"Level 9\"] = \"Cutscena\",\n  [\"Level 10\"] = \"Walka\",\n}\nlocal busy = {}\n\nlocal function nextLevel(player, delay)\n  local from = getLevel(player)\n  local to = NEXT[from]\n  if not to or busy[player] == from then return end\n  busy[player] = from\n  after(delay or 0, function()\n    busy[player] = nil\n    if getLevel(player) == from then setLevel(player, to) end\n  end)\nend\n\nonLevelEnter(function(player, level)\n  busy[player] = nil\n  resetPlayerAnimations(player)\nend)\n\n-- tabliczka zmienia się na \"koniec\", a po chwili następny poziom\nonTouch(\"Wygrana_obstacle\", function(player)\n  if busy[player] then return end\n  local level = getLevel(player)\n  after(0.5, function() setAnimation(\"Tabliczka\", \"kon\", level) end)\n  nextLevel(player, 2.5)\nend)\n\n-- przejścia od razu (drzwi / portal)\nonTouch(\"NewSprite\", function(player)\n  local level = getLevel(player)\n  -- w poziomach 5 i 10 ten obiekt zabijał (zaczynał poziom od nowa)\n  if level == \"Level 5\" or level == \"Level 10\" then kill(player) return end\n  nextLevel(player, 0)\nend)\nonTouch(\"Przeniesienie\", function(player) if getLevel(player) == \"Level 5\" then nextLevel(player, 0) end end)\nonTouch(\"NewSpritesiz\", function(player) nextLevel(player, 0) end)\nonTouch(\"NewSprite3\", function(player) if getLevel(player) == \"Level 10\" then setLevel(player, \"Walka\") end end)\n\n-- teleport: po 2 sekundach przenosi dalej\nonTouch(\"Teleporter\", function(player)\n  playSound(\"Confirm_03.aac\", player)\n  nextLevel(player, 2.2)\nend)\n\n-- spadanie w dół\nonTouch(\"Spadanie_obstacle\", function(player)\n  setPlayerAnimation(player, \"fall\", \"Spadanie\")\n  setPlayerAnimation(player, \"jump\", \"Spadanie\")\nend)\n\n-- koniec poziomu 5 i 10: ludzik zaczyna \"gujować\"\nonTouch(\"Guj_obstacle\", function(player)\n  after(1, function() setPlayerAnimation(player, \"idle\", \"Gujowanie\") end)\nend)\n\n-- spadnięcie w przepaść = poziom od nowa\nonTouch(\"NewSprite2\", function(player) kill(player) end)\n",
    "enabled": true
   },
   {
    "id": "mutheg9fs5nxd5",
    "name": "Przerywniki",
    "type": "lua",
    "source": "-- Obrazki między poziomami: gracz schowany, po chwili dalej\nlocal CUTS = {\n  [\"Ending\"] = { 5, \"Level 6\" },\n  [\"Cutscena\"] = { 6, \"Level 10\" },\n  [\"PrzedEnding\"] = { 0.72, \"Kosmiczna walka\" },\n}\nonLevelEnter(function(player, level)\n  local c = CUTS[level]\n  if not c then return end\n  hidePlayer(player, true)\n  after(c[1], function()\n    if getLevel(player) == level then setLevel(player, c[2]) end\n  end)\nend)\n",
    "enabled": true
   },
   {
    "id": "mutheg9fs66n62",
    "name": "Kosmiczna walka",
    "type": "lua",
    "source": "-- Lot przez kosmos: ludzik sam leci w prawo, kamienie rozbijają się po dotknięciu\nonLevelEnter(function(player, level)\n  if level == \"Kosmiczna walka\" then setForce(player, 500) end\nend)\nonTouch(\"Meta\", function(player)\n  if getLevel(player) == \"Kosmiczna walka\" then setLevel(player, \"Walka 2\") end\nend)\n",
    "enabled": true
   },
   {
    "id": "mutheg9fs7fg50",
    "name": "Walki z Gigantem",
    "type": "lua",
    "source": "-- Gigant atakuje według planu z GDevelopa (czas od początku walki).\n-- Dotknięcie Giganta = walka od nowa. Kto przetrwa do końca, wygrywa.\nlocal FIGHTS = {\n  [\"Walka\"] = { next = \"PrzedEnding\", steps = {\n    {2, \"anim\", \"Kula\"},\n    {2, \"move\", 607, 177, 0.5},\n    {3, \"move\", 614, 404, 0.2},\n    {3.1, \"anim\", \"Idle\"},\n    {3.1, \"move\", 621, 384, 0.1},\n    {3.1, \"sound\", \"Walniecie.mp3\"},\n    {4.1, \"move\", 873, 384, 0.5},\n    {4.1, \"anim\", \"Chodzenie\"},\n    {4.9, \"anim\", \"Idle\"},\n    {5.9, \"move\", 875, 319, 0.2},\n    {5.9, \"anim\", \"Drop Dash\"},\n    {6.4, \"move\", 873, 384, 0.2},\n    {6.4, \"anim\", \"Chodzenie\"},\n    {6.6, \"sound\", \"dropdash.ogg\"},\n    {6.6, \"move\", 339, 384, 0.5},\n    {6.7, \"flip\", \"false\"},\n    {6.7, \"anim\", \"Idle\"},\n    {7.7, \"move\", 339, 319, 0.2},\n    {7.7, \"anim\", \"Drop Dash\"},\n    {8.2, \"move\", 339, 384, 0.2},\n    {8.4, \"anim\", \"Chodzenie\"},\n    {8.4, \"move\", 873, 384, 0.5},\n    {8.4, \"sound\", \"dropdash.ogg\"},\n    {8.5, \"flip\", \"true\"},\n    {8.5, \"anim\", \"Idle\"},\n    {9.5, \"anim\", \"Kula\"},\n    {9.5, \"move\", 607, 177, 0.5},\n    {10.5, \"move\", 614, 404, 0.2},\n    {10.6, \"anim\", \"Idle\"},\n    {10.6, \"move\", 621, 384, 0.1},\n    {10.6, \"sound\", \"Walniecie.mp3\"},\n    {11.6, \"move\", 873, 384, 0.5},\n    {11.6, \"anim\", \"Chodzenie\"},\n    {12.4, \"anim\", \"Idle\"},\n    {13.4, \"move\", 875, 319, 0.2},\n    {13.4, \"anim\", \"Drop Dash\"},\n    {13.9, \"move\", 873, 384, 0.2},\n    {13.9, \"anim\", \"Chodzenie\"},\n    {14.1, \"sound\", \"dropdash.ogg\"},\n    {14.1, \"move\", 339, 384, 0.5},\n    {14.2, \"flip\", \"false\"},\n    {14.2, \"anim\", \"Idle\"},\n    {15.2, \"move\", 339, 319, 0.2},\n    {15.2, \"anim\", \"Drop Dash\"},\n    {15.7, \"move\", 339, 384, 0.2},\n    {15.9, \"anim\", \"Chodzenie\"},\n    {15.9, \"move\", 873, 384, 0.5},\n    {15.9, \"sound\", \"dropdash.ogg\"},\n    {16, \"flip\", \"true\"},\n    {16, \"anim\", \"Idle\"},\n    {17, \"anim\", \"Kula\"},\n    {17, \"move\", 607, 177, 0.5},\n    {18, \"move\", 614, 404, 0.2},\n    {18.1, \"anim\", \"Idle\"},\n    {18.1, \"move\", 621, 384, 0.1},\n    {18.1, \"sound\", \"Walniecie.mp3\"},\n    {19.1, \"move\", 873, 384, 0.5},\n    {19.1, \"anim\", \"Chodzenie\"},\n    {19.9, \"anim\", \"Idle\"},\n    {20.9, \"move\", 875, 319, 0.2},\n    {20.9, \"anim\", \"Drop Dash\"},\n    {21.4, \"move\", 873, 384, 0.2},\n    {21.4, \"anim\", \"Chodzenie\"},\n    {21.6, \"sound\", \"dropdash.ogg\"},\n    {21.6, \"move\", 339, 384, 0.5},\n    {21.7, \"flip\", \"false\"},\n    {21.7, \"anim\", \"Idle\"},\n    {22.7, \"move\", 339, 319, 0.2},\n    {22.7, \"anim\", \"Drop Dash\"},\n    {23.2, \"move\", 339, 384, 0.2},\n    {23.4, \"anim\", \"Chodzenie\"},\n    {23.4, \"move\", 873, 384, 0.5},\n    {23.4, \"sound\", \"dropdash.ogg\"},\n    {23.5, \"flip\", \"true\"},\n    {23.5, \"anim\", \"Idle\"},\n    {24.5, \"anim\", \"Defeated\"},\n    {24.5, \"sound\", \"Rozwalenie.mp3\"},\n    {27.5, \"end\"},\n  } },\n  [\"Walka 2\"] = { next = \"KONIEC\", steps = {\n    {2, \"anim\", \"Kula\"},\n    {2, \"move\", 857, 196, 0.5},\n    {2.5, \"move\", 772, 197, 0.2},\n    {2.6, \"anim\", \"Idle\"},\n    {2.6, \"move\", 621, 384, 0.1},\n    {2.6, \"sound\", \"S3K_4E.wav\"},\n    {3.6, \"move\", 343, 384, 0.5},\n    {3.6, \"flip\", \"false\"},\n    {3.6, \"anim\", \"Chodzenie\"},\n    {4.4, \"anim\", \"Idle\"},\n    {5.4, \"sound\", \"S3K_3C.wav\"},\n    {5.4, \"anim\", \"Kula\"},\n    {5.4, \"move\", 861, 400, 0.5},\n    {6.4, \"sound\", \"S3K_3C.wav\"},\n    {6.4, \"move\", 347, 400, 0.5},\n    {7.4, \"sound\", \"S3K_3C.wav\"},\n    {7.4, \"move\", 861, 400, 0.5},\n    {7.9, \"move\", 861, 384, 0.1},\n    {7.9, \"anim\", \"Idle\"},\n    {7.9, \"flip\", \"true\"},\n    {8.9, \"anim\", \"Drop Dash\"},\n    {8.9, \"move\", 861, 306, 0.5},\n    {9.4, \"move\", 861, 384, 0.2},\n    {9.6, \"move\", 347, 384, 0.2},\n    {9.6, \"sound\", \"dropdash.ogg\"},\n    {10.1, \"flip\", \"false\"},\n    {10.1, \"anim\", \"Idle\"},\n    {11.1, \"move\", 355, 312, 0.5},\n    {11.1, \"anim\", \"Drop Dash\"},\n    {11.6, \"move\", 347, 384, 0.2},\n    {11.8, \"sound\", \"dropdash.ogg\"},\n    {11.8, \"move\", 861, 384, 0.2},\n    {11.8, \"anim\", \"Chodzenie\"},\n    {12, \"anim\", \"Idle\"},\n    {12, \"flip\", \"true\"},\n    {13, \"anim\", \"Kula\"},\n    {13, \"move\", 857, 196, 0.5},\n    {13.5, \"move\", 772, 197, 0.2},\n    {13.6, \"anim\", \"Idle\"},\n    {13.6, \"move\", 621, 384, 0.1},\n    {13.6, \"sound\", \"S3K_4E.wav\"},\n    {14.6, \"move\", 343, 384, 0.5},\n    {14.6, \"flip\", \"false\"},\n    {14.6, \"anim\", \"Chodzenie\"},\n    {15.4, \"anim\", \"Idle\"},\n    {16.4, \"sound\", \"S3K_3C.wav\"},\n    {16.4, \"anim\", \"Kula\"},\n    {16.4, \"move\", 861, 400, 0.5},\n    {17.4, \"sound\", \"S3K_3C.wav\"},\n    {17.4, \"move\", 347, 400, 0.5},\n    {18.4, \"sound\", \"S3K_3C.wav\"},\n    {18.4, \"move\", 861, 400, 0.5},\n    {18.9, \"move\", 861, 384, 0.1},\n    {18.9, \"anim\", \"Idle\"},\n    {18.9, \"flip\", \"true\"},\n    {19.9, \"anim\", \"Drop Dash\"},\n    {19.9, \"move\", 861, 306, 0.5},\n    {20.4, \"move\", 861, 384, 0.2},\n    {20.6, \"move\", 347, 384, 0.2},\n    {20.6, \"sound\", \"dropdash.ogg\"},\n    {21.1, \"flip\", \"false\"},\n    {21.1, \"anim\", \"Idle\"},\n    {22.1, \"move\", 355, 312, 0.5},\n    {22.1, \"anim\", \"Drop Dash\"},\n    {22.6, \"move\", 347, 384, 0.2},\n    {22.8, \"sound\", \"dropdash.ogg\"},\n    {22.8, \"move\", 861, 384, 0.2},\n    {22.8, \"anim\", \"Chodzenie\"},\n    {23, \"anim\", \"Idle\"},\n    {23, \"flip\", \"true\"},\n    {24, \"anim\", \"Kula\"},\n    {24, \"move\", 857, 196, 0.5},\n    {24.5, \"move\", 772, 197, 0.2},\n    {24.6, \"anim\", \"Idle\"},\n    {24.6, \"move\", 621, 384, 0.1},\n    {24.6, \"sound\", \"S3K_4E.wav\"},\n    {25.6, \"move\", 343, 384, 0.5},\n    {25.6, \"flip\", \"false\"},\n    {25.6, \"anim\", \"Chodzenie\"},\n    {26.4, \"anim\", \"Idle\"},\n    {27.4, \"sound\", \"S3K_3C.wav\"},\n    {27.4, \"anim\", \"Kula\"},\n    {27.4, \"move\", 861, 400, 0.5},\n    {28.4, \"sound\", \"S3K_3C.wav\"},\n    {28.4, \"move\", 347, 400, 0.5},\n    {29.4, \"sound\", \"S3K_3C.wav\"},\n    {29.4, \"move\", 861, 400, 0.5},\n    {29.9, \"move\", 861, 384, 0.1},\n    {29.9, \"anim\", \"Idle\"},\n    {29.9, \"flip\", \"true\"},\n    {30.9, \"anim\", \"Drop Dash\"},\n    {30.9, \"move\", 861, 306, 0.5},\n    {31.4, \"move\", 861, 384, 0.2},\n    {31.6, \"move\", 347, 384, 0.2},\n    {31.6, \"sound\", \"dropdash.ogg\"},\n    {32.1, \"flip\", \"false\"},\n    {32.1, \"anim\", \"Idle\"},\n    {33.1, \"move\", 355, 312, 0.5},\n    {33.1, \"anim\", \"Drop Dash\"},\n    {33.6, \"move\", 347, 384, 0.2},\n    {33.8, \"sound\", \"dropdash.ogg\"},\n    {33.8, \"move\", 861, 384, 0.2},\n    {33.8, \"anim\", \"Chodzenie\"},\n    {34, \"anim\", \"Idle\"},\n    {34, \"flip\", \"true\"},\n    {35, \"anim\", \"Defeated\"},\n    {35, \"sound\", \"Rozwalenie.mp3\"},\n    {38, \"end\"},\n  } },\n}\nlocal run = {}\nlocal running = {}\n\nlocal function soundAll(level, name)\n  for _, p in ipairs(getPlayersOnLevel(level)) do playSound(name, p) end\nend\n\nlocal function startFight(level)\n  local f = FIGHTS[level]\n  run[level] = (run[level] or 0) + 1\n  running[level] = true\n  local my = run[level]\n  for _, s in ipairs(f.steps) do\n    after(s[1], function()\n      if run[level] ~= my then return end\n      local kind = s[2]\n      if kind == \"move\" then moveObject(\"Gigant\", s[3], s[4], s[5], level)\n      elseif kind == \"anim\" then setAnimation(\"Gigant\", s[3], level)\n      elseif kind == \"flip\" then flipObject(\"Gigant\", s[3] == \"true\", level)\n      elseif kind == \"sound\" then soundAll(level, s[3])\n      elseif kind == \"end\" then\n        running[level] = false\n        for _, p in ipairs(getPlayersOnLevel(level)) do\n          if f.next == \"KONIEC\" then\n            tell(p, \"🎉 Gigant pokonany! Koniec gry - brawo!\")\n            awardBadge(p, \"Pogromca Giganta\")\n            setLevel(p, \"Menu\")\n          else\n            setLevel(p, f.next)\n          end\n        end\n      end\n    end)\n  end\nend\n\nonLevelEnter(function(player, level)\n  if FIGHTS[level] and not running[level] then startFight(level) end\nend)\n\n-- Gigant dotknął gracza: walka od nowa (dla wszystkich na arenie)\nonDied(function(player)\n  local level = getLevel(player)\n  if not FIGHTS[level] then return end\n  running[level] = false\n  run[level] = (run[level] or 0) + 1\n  after(1, function() restartLevel(level) end)\nend)\n",
    "enabled": true
   }
