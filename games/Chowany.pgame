    "reward": 10
   },
   {
    "id": "mufw8rcujb1rqu",
    "name": "Łowca",
    "icon": "🔎",
    "description": "Znajdź 3 osoby w jednej rundzie",
    "trigger": "script",
    "reward": 10
   }
